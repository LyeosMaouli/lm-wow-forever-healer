# Production release tooling requires a CI-published immutable digest.
IMAGE_REF=ghcr.io/REPLACE_WITH_OWNER/REPLACE_WITH_REPOSITORY@sha256:REPLACE_WITH_DIGEST
# Node/local development. Production Compose fixes HOST and PORT internally.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Only for compose.dev.yml, bound to loopback.
LOCAL_PORT=3000

{
  "name": "forever-healing",
  "version": "1.0.0",
  "private": true,
  "description": "Guide interactif des healers de WoW Forever, autonome et auto-hébergeable.",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server.mjs --dev",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "healthcheck": "node --env-file-if-exists=.env scripts/healthcheck.mjs"
  }
}
